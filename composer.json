{
    "name": "roundly-consulting/enums-for-laravel",
    "description": "Convenient helper methods for PHP enums in Laravel applications",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "enums",
        "helpers"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/enums-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/enums-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Enums\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Enums\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
